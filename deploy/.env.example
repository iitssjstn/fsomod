# Publieke URL van je website (zonder / aan het eind). Moet HTTPS zijn voor Twitch EventSub.
BASE_URL=https://sabotage.jouwdomein.nl

# Van https://dev.twitch.tv/console/apps
# OAuth Redirect URL in de Twitch console: <BASE_URL>/auth/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Willekeurige geheimen, maak ze met:  openssl rand -hex 32
SESSION_SECRET=
# 10-100 tekens
EVENTSUB_SECRET=

PORT=3000

# Alleen voor het Caddy-profiel: je domein (zonder https://)
DOMAIN=sabotage.jouwdomein.nl
