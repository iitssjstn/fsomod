# Alleen nodig als je al nginx gebruikt (anders: Caddy-profiel in docker-compose.yml).
# HTTPS-certificaat bijvoorbeeld met:  certbot --nginx -d sabotage.jouwdomein.nl
server {
    server_name sabotage.jouwdomein.nl;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket voor het hulpprogramma
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 1h;

        # Server-Sent Events (live logboek + overlay)
        proxy_buffering off;
    }

    listen 80;
}
